## src/types.ts

```ts
export type TokenAmount = { mint: string; decimals: number; amount: string }; // amount as string in smallest units

export type PaymentIntent = {
  id: string;
  createdAt: number;
  expiresAt: number;
  amount: TokenAmount;
  merchantId: string; // opaque merchant handle
  resourceId: string; // what is being purchased
  settlementMode: "public" | "elusiv" | "confidential" | "light";
  status: "created" | "pending" | "confirmed" | "expired" | "failed";
  payer?: string; // base58 pubkey (optional)
  txSignature?: string;
};

export type Receipt = {
  intentId: string;
  merchantId: string;
  resourceId: string;
  amount: TokenAmount;
  settledAt: number;
  settlementMode: PaymentIntent["settlementMode"];
  txSignature?: string;
  // ed25519 signature by gateway over the canonical payload
  gatewayPubkey: string;
  signature: string; // base58
};
```

