## src/middleware/send402.ts

```ts
import type { Request, Response } from "express";

/**
 * Sends a standards-friendly 402 payload with minimal metadata.
 * You can tune fields to align with your x402 profile.
 */
export function send402(res: Response, opts: {
  price: string; // human string e.g. "2 USDC"
  tokenMint: string;
  gatewayUrl: string;
  resourceId: string;
}) {
  res.setHeader("WWW-Authenticate", "x402");
  res.status(402).json({
    price: opts.price,
    token_mint: opts.tokenMint,
    gateway_url: opts.gatewayUrl,
    resource_id: opts.resourceId,
  });
}
```

