## src/store/memory.ts

```ts
import type { PaymentIntent } from "../types.js";

const intents = new Map<string, PaymentIntent>();

export function saveIntent(pi: PaymentIntent) {
  intents.set(pi.id, pi);
  return pi;
}

export function getIntent(id: string) {
  return intents.get(id) || null;
}

export function updateIntent(id: string, patch: Partial<PaymentIntent>) {
  const cur = intents.get(id);
  if (!cur) return null;
  const next = { ...cur, ...patch } as PaymentIntent;
  intents.set(id, next);
  return next;
}
```

---

## src/routes/payments.ts

```ts
import { Router } from "express";
import { randomUUID } from "crypto";
import { saveIntent, getIntent, updateIntent } from "../store/memory.js";
import { signReceipt } from "../crypto/receipt.js";
import type { PaymentIntent } from "../types.js";
import { isValidPubkey, waitForConfirmation } from "../services/solana.js";

const router = Router();

// Create a payment intent (called by the client after receiving 402 from merchant)
router.post("/pay-intent", (req, res) => {
  const { amount, mint, merchantId, resourceId, settlementMode = "elusiv", payer } = req.body ?? {};
  if (!amount || !mint || !merchantId || !resourceId) {
    return res.status(400).json({ error: "Missing fields" });
  }
  if (payer && !isValidPubkey(payer)) {
    return res.status(400).json({ error: "Invalid payer pubkey" });
  }

  const id = randomUUID();
  const now = Date.now();
  const intent: PaymentIntent = {
    id,
    createdAt: now,
    expiresAt: now + 10 * 60_000,
    amount: { amount: String(amount), mint, decimals: 6 }, // set decimals per mint in real impl
    merchantId,
    resourceId,
    settlementMode,
    status: "created",
    payer,
  };

  saveIntent(intent);
  return res.json({ intent_id: id, expires_at: intent.expiresAt });
});

// Client notifies gateway of on-chain payment (tx signature or privacy proof)
router.post("/notify", async (req, res) => {
  const { intentId, txSignature, proof } = req.body ?? {};
  const intent = intentId && getIntent(intentId);
  if (!intent) return res.status(404).json({ error: "Unknown intent" });
  if (Date.now() > intent.expiresAt) return res.status(410).json({ error: "Intent expired" });

  try {
    if (txSignature) {
      // Public SPL path: wait for confirmation
      await waitForConfirmation(txSignature);
      updateIntent(intentId, { status: "confirmed", txSignature });
    } else if (proof) {
      // Privacy paths (stubs)
      if (intent.settlementMode === "elusiv") {
        // TODO: verify with Elusiv SDK
        const { txSignature: sig } = { txSignature: "ELUSIV_TX_SIG_PLACEHOLDER" };
        updateIntent(intentId, { status: "confirmed", txSignature: sig });
      } else if (intent.settlementMode === "confidential") {
        const { txSignature: sig } = { txSignature: "CONFIDENTIAL_TX_SIG_PLACEHOLDER" };
        updateIntent(intentId, { status: "confirmed", txSignature: sig });
      } else if (intent.settlementMode === "light") {
        const { txSignature: sig } = { txSignature: "LIGHT_TX_SIG_PLACEHOLDER" };
        updateIntent(intentId, { status: "confirmed", txSignature: sig });
      }
    } else {
      return res.status(400).json({ error: "Provide txSignature or proof" });
    }

    const updated = getIntent(intentId)!;
    const receipt = signReceipt({
      intentId: updated.id,
      merchantId: updated.merchantId,
      resourceId: updated.resourceId,
      amount: updated.amount,
      settledAt: Date.now(),
      settlementMode: updated.settlementMode,
      txSignature: updated.txSignature,
    });

    return res.json({ ok: true, receipt });
  } catch (e: any) {
    return res.status(500).json({ error: e.message || "Verification failed" });
  }
});

// Merchant
```
