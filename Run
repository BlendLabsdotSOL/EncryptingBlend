## src/crypto/keys.ts

```ts
import bs58 from "bs58";
import nacl from "tweetnacl";

let cached: { secretKey: Uint8Array; publicKey: string } | null = null;

export function getGatewayKeypair() {
  if (cached) return cached;
  const env = process.env.GATEWAY_SECRET_KEY?.trim();
  let keypair: nacl.SignKeyPair;
  if (env) {
    const secret = bs58.decode(env);
    keypair = nacl.sign.keyPair.fromSecretKey(secret);
  } else {
    keypair = nacl.sign.keyPair();
    // NOTE: print once for operator to persist
    // eslint-disable-next-line no-console
    console.warn("[Blend] Generated ephemeral gateway keypair. Persist GATEWAY_SECRET_KEY (base58):", bs58.encode(keypair.secretKey));
  }
  cached = { secretKey: keypair.secretKey, publicKey: bs58.encode(keypair.publicKey) };
  return cached;
}
```

---

## src/crypto/receipt.ts

```ts
import bs58 from "bs58";
import nacl from "tweetnacl";
import type { Receipt } from "../types.js";
import { getGatewayKeypair } from "./keys.js";

export function canonicalize(r: Omit<Receipt, "gatewayPubkey" | "signature">) {
  // Deterministic JSON string used for signing & verification
  return JSON.stringify({
    intentId: r.intentId,
    merchantId: r.merchantId,
    resourceId: r.resourceId,
    amount: r.amount,
    settledAt: r.settledAt,
    settlementMode: r.settlementMode,
    txSignature: r.txSignature || null,
  });
}

export function signReceipt(payload: Omit<Receipt, "gatewayPubkey" | "signature">): Receipt {
  const msg = new TextEncoder().encode(canonicalize(payload));
  const kp = getGatewayKeypair();
  const sig = nacl.sign.detached(msg, kp.secretKey);
  return { ...payload, gatewayPubkey: kp.publicKey, signature: bs58.encode(sig) };
}

export function verifyReceipt(r: Receipt): boolean {
  const msg = new TextEncoder().encode(canonicalize(r));
  const sig = bs58.decode(r.signature);
  const pub = bs58.decode(r.gatewayPubkey);
  return nacl.sign.detached.verify(msg, sig, pub);
}
```

